CLAUDE.md
archive/

# LaTeX build intermediates. The PDFs (main.pdf, highlights.pdf) are
# deliberately tracked; these are regenerated by latexmk and should
# not be.
paper/*.spl
paper/*.aux
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.blg
paper/*.synctex.gz

# Derived corpora. data/newsroom.jsonl is produced from the upstream
# Newsroom human-evaluation CSV by `make data/newsroom.jsonl`; it is
# third-party article text and is regenerable, so it is not tracked.
data/
